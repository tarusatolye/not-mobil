    <name>tarus Not</name>
    <summary>Handwritten notes and sketches, synced between phone and web</summary>
    <url type="homepage">https://yazilim.tarus.tr/</url>
    <url type="vcs-browser">https://github.com/tarusatolye/not-mobil</url>

    <developer id="tr.tarus">
        <name>tarus</name>
    </developer>

    <branding>
        <color type="primary" scheme_preference="light">#fff6da</color>
        <color type="primary" scheme_preference="dark">#705600</color>
    </branding>

    <metadata_license>MIT</metadata_license>
    <project_license>GPL-3.0-only</project_license>

    <supports>
        <control>pointing</control>
        <control>keyboard</control>
        <control>touch</control>
    </supports>

    <recommends>
        <control>tablet</control>
        <internet>always</internet>
    </recommends>

    <requires>
        <display_length compare="ge">360</display_length>
    </requires>

    <provides>
        <mediatype>application/sbn</mediatype>
        <mediatype>application/json</mediatype>
        <mediatype>text/*</mediatype>

        <mediatype>application/sbn2</mediatype>
        <mediatype>application/octet-stream</mediatype>

        <mediatype>application/sba</mediatype>
        <mediatype>application/zip</mediatype>
    </provides>

    <description>
        <!--
        DO NOT EDIT.
        Any modifications will be overwritten.
        This <description/> tag is generated by bump_version.dart from `metadata/*/full_description.txt`.
        -->
        <p>
            Not is the handwriting and sketch notes app of the tarus ecosystem.
        </p>
        <p>
            Write and draw with a stylus or your finger: pens, highlighter, shapes, images and PDFs on pages or a whiteboard. In dark mode your notes can be inverted, so you write with light ink on a dark background; images and PDFs are inverted too.
        </p>
        <p>
            Your notes live in one list on your phone and on the web (not.tarus.tr): a note written on the phone appears on the web and vice versa. Transfers are encrypted with HTTPS, and the Not server stores notes encrypted on disk and in backups. No separate encryption password is needed.
        </p>
        <p>
            Not has no separate account: you connect with a sync token from your Pusula account (Pusula > Settings > Not sync). You can revoke the token at any time, and the device stops syncing within 30 seconds. Notes sync between your devices; when the same note changes in two places, the older version is kept as a conflict copy instead of being lost.
        </p>
        <p>
            Organise notes in nested folders, find recent notes on the home screen, and report a problem from inside the app (Settings > Hata bildir, or press and hold an empty area).
        </p>
        <p>
            Not is based on the open source Saber app (© 2022- Adil Hanney and contributors) and, like Saber, is licensed under the GNU General Public License version 3 (GPL-3.0). Source code: https://github.com/tarusatolye/not-mobil
        </p>

    </description>

    <launchable type="desktop-id">com.adilhanney.saber.desktop</launchable>

    <content_rating type="oars-1.1" />

